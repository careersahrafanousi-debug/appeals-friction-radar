// DAX measures - Appeals Friction Radar
// Generated by src/build_bi_assets.py from dashboard/dashboard_config.json.
// Paste into Power BI Desktop, or open powerbi/model.bim in Tabular Editor.

// Appeals closed from the headline query extract.
Appeals closed =
    SELECTEDVALUE ( 'headline'[appeals] )
// format: #,0

// 30-day target
SLA compliance =
    SELECTEDVALUE ( 'headline'[sla_pct] )
// format: 0.00"%"

// The average is not the problem
Avg turnaround =
    SELECTEDVALUE ( 'headline'[avg_tat] )
// format: #,0.0"d"

// First-pass routing from the headline query extract.
First-pass routing =
    SELECTEDVALUE ( 'headline'[routing_pct] )
// format: 0.00"%"

// Rework rate from the headline query extract.
Rework rate =
    SELECTEDVALUE ( 'headline'[rework_pct] )
// format: 0.00"%"

// Escalation rate from the headline query extract.
Escalation rate =
    SELECTEDVALUE ( 'headline'[escalation_pct] )
// format: 0.00"%"

// Drives the pending-info clock
Incomplete at intake =
    SELECTEDVALUE ( 'headline'[doc_gap_pct] )
// format: 0.00"%"

// 52 of 4,018 records excluded
Data quality score =
    SELECTEDVALUE ( 'headline'[dq_score] )
// format: 0.00"%"

// Average days in stage for the 'Where the days actually go' visual.
Average days in stage (stages) =
    SUM ( 'stages'[avg_days] )
// format: #,0.00

// % of turnaround for the 'Share of total turnaround' visual.
% of turnaround (stages) =
    AVERAGE ( 'stages'[pct_of_tat] )
// format: #,0.00

// Avg turnaround (days) for the 'Turnaround against the target, by appeal type' visual.
Avg turnaround (days) (by_type) =
    AVERAGE ( 'by_type'[avg_tat] )
// format: #,0.00

// SLA target (days) for the 'Turnaround against the target, by appeal type' visual.
SLA target (days) (by_type) =
    SUM ( 'by_type'[target_days] )
// format: #,0.00

// SLA compliance % for the 'SLA compliance by type' visual.
SLA compliance % (by_type) =
    AVERAGE ( 'by_type'[sla_pct] )
// format: #,0.00

// Avg turnaround (days) for the 'Friction bands behave the way the score says they should' visual.
Avg turnaround (days) (friction) =
    AVERAGE ( 'friction'[avg_tat] )
// format: #,0.00

// SLA compliance % for the 'Friction bands behave the way the score says they should' visual.
SLA compliance % (friction) =
    AVERAGE ( 'friction'[sla_pct] )
// format: #,0.00

// Rework % for the 'Friction bands behave the way the score says they should' visual.
Rework % (friction) =
    AVERAGE ( 'friction'[rework_pct] )
// format: #,0.00

// Avg turnaround (days) for the 'The cost of an incomplete intake' visual.
Avg turnaround (days) (doc_gap) =
    AVERAGE ( 'doc_gap'[avg_tat] )
// format: #,0.00

// Pending-info days for the 'The cost of an incomplete intake' visual.
Pending-info days (doc_gap) =
    SUM ( 'doc_gap'[pending_days] )
// format: #,0.00

// Intake days for the 'The cost of an incomplete intake' visual.
Intake days (doc_gap) =
    SUM ( 'doc_gap'[intake_days] )
// format: #,0.00

// Avg turnaround (days) for the 'What rework costs' visual.
Avg turnaround (days) (rework) =
    AVERAGE ( 'rework'[avg_tat] )
// format: #,0.00

// SLA compliance % for the 'What rework costs' visual.
SLA compliance % (rework) =
    AVERAGE ( 'rework'[sla_pct] )
// format: #,0.00

// Appeals received for the 'Monthly trend' visual.
Appeals received (monthly) =
    SUM ( 'monthly'[received] )
// format: #,0.00

// SLA compliance % for the 'Monthly trend' visual.
SLA compliance % (monthly) =
    AVERAGE ( 'monthly'[sla_pct] )
// format: #,0.00

// Avg turnaround (days) for the 'Monthly trend' visual.
Avg turnaround (days) (monthly) =
    AVERAGE ( 'monthly'[avg_tat] )
// format: #,0.00

// Avg turnaround (days) for the 'Urgent triage is not actually urgent' visual.
Avg turnaround (days) (priority) =
    AVERAGE ( 'priority'[avg_tat] )
// format: #,0.00

// SLA target (days) for the 'Urgent triage is not actually urgent' visual.
SLA target (days) (priority) =
    SUM ( 'priority'[target_days] )
// format: #,0.00

// SLA compliance % for the 'Urgent triage is not actually urgent' visual.
SLA compliance % (priority) =
    AVERAGE ( 'priority'[sla_pct] )
// format: #,0.00

// Events for the 'Logged delay reasons' visual.
Events (delay_reasons) =
    SUM ( 'delay_reasons'[events] )
// format: #,0.00
