{
  "name": "appeals-friction-radar",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "headline",
        "columns": [
          {
            "name": "appeals",
            "dataType": "int64",
            "sourceColumn": "appeals",
            "summarizeBy": "sum"
          },
          {
            "name": "sla_pct",
            "dataType": "double",
            "sourceColumn": "sla_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_tat",
            "dataType": "double",
            "sourceColumn": "avg_tat",
            "summarizeBy": "sum"
          },
          {
            "name": "rework_pct",
            "dataType": "double",
            "sourceColumn": "rework_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "escalation_pct",
            "dataType": "double",
            "sourceColumn": "escalation_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "routing_pct",
            "dataType": "double",
            "sourceColumn": "routing_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "doc_gap_pct",
            "dataType": "double",
            "sourceColumn": "doc_gap_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "dq_score",
            "dataType": "double",
            "sourceColumn": "dq_score",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "headline",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\headline.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Appeals closed",
            "expression": "SELECTEDVALUE ( 'headline'[appeals] )",
            "formatString": "#,0",
            "description": "Appeals closed from the headline query extract."
          },
          {
            "name": "SLA compliance",
            "expression": "SELECTEDVALUE ( 'headline'[sla_pct] )",
            "formatString": "0.00\"%\"",
            "description": "30-day target"
          },
          {
            "name": "Avg turnaround",
            "expression": "SELECTEDVALUE ( 'headline'[avg_tat] )",
            "formatString": "#,0.0\"d\"",
            "description": "The average is not the problem"
          },
          {
            "name": "First-pass routing",
            "expression": "SELECTEDVALUE ( 'headline'[routing_pct] )",
            "formatString": "0.00\"%\"",
            "description": "First-pass routing from the headline query extract."
          },
          {
            "name": "Rework rate",
            "expression": "SELECTEDVALUE ( 'headline'[rework_pct] )",
            "formatString": "0.00\"%\"",
            "description": "Rework rate from the headline query extract."
          },
          {
            "name": "Escalation rate",
            "expression": "SELECTEDVALUE ( 'headline'[escalation_pct] )",
            "formatString": "0.00\"%\"",
            "description": "Escalation rate from the headline query extract."
          },
          {
            "name": "Incomplete at intake",
            "expression": "SELECTEDVALUE ( 'headline'[doc_gap_pct] )",
            "formatString": "0.00\"%\"",
            "description": "Drives the pending-info clock"
          },
          {
            "name": "Data quality score",
            "expression": "SELECTEDVALUE ( 'headline'[dq_score] )",
            "formatString": "0.00\"%\"",
            "description": "52 of 4,018 records excluded"
          }
        ]
      },
      {
        "name": "stages",
        "columns": [
          {
            "name": "stage",
            "dataType": "string",
            "sourceColumn": "stage",
            "summarizeBy": "none"
          },
          {
            "name": "avg_days",
            "dataType": "double",
            "sourceColumn": "avg_days",
            "summarizeBy": "sum"
          },
          {
            "name": "pct_of_tat",
            "dataType": "double",
            "sourceColumn": "pct_of_tat",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "stages",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\stages.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Average days in stage (stages)",
            "expression": "SUM ( 'stages'[avg_days] )",
            "formatString": "#,0.00",
            "description": "Average days in stage for the 'Where the days actually go' visual."
          },
          {
            "name": "% of turnaround (stages)",
            "expression": "AVERAGE ( 'stages'[pct_of_tat] )",
            "formatString": "#,0.00",
            "description": "% of turnaround for the 'Share of total turnaround' visual."
          }
        ]
      },
      {
        "name": "by_type",
        "columns": [
          {
            "name": "Appeal_Type",
            "dataType": "string",
            "sourceColumn": "Appeal_Type",
            "summarizeBy": "none"
          },
          {
            "name": "appeals",
            "dataType": "int64",
            "sourceColumn": "appeals",
            "summarizeBy": "sum"
          },
          {
            "name": "sla_pct",
            "dataType": "double",
            "sourceColumn": "sla_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_tat",
            "dataType": "double",
            "sourceColumn": "avg_tat",
            "summarizeBy": "sum"
          },
          {
            "name": "target_days",
            "dataType": "int64",
            "sourceColumn": "target_days",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "by_type",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\by_type.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Avg turnaround (days) (by_type)",
            "expression": "AVERAGE ( 'by_type'[avg_tat] )",
            "formatString": "#,0.00",
            "description": "Avg turnaround (days) for the 'Turnaround against the target, by appeal type' visual."
          },
          {
            "name": "SLA target (days) (by_type)",
            "expression": "SUM ( 'by_type'[target_days] )",
            "formatString": "#,0.00",
            "description": "SLA target (days) for the 'Turnaround against the target, by appeal type' visual."
          },
          {
            "name": "SLA compliance % (by_type)",
            "expression": "AVERAGE ( 'by_type'[sla_pct] )",
            "formatString": "#,0.00",
            "description": "SLA compliance % for the 'SLA compliance by type' visual."
          }
        ]
      },
      {
        "name": "friction",
        "columns": [
          {
            "name": "Friction_Category",
            "dataType": "string",
            "sourceColumn": "Friction_Category",
            "summarizeBy": "none"
          },
          {
            "name": "appeals",
            "dataType": "int64",
            "sourceColumn": "appeals",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_tat",
            "dataType": "double",
            "sourceColumn": "avg_tat",
            "summarizeBy": "sum"
          },
          {
            "name": "sla_pct",
            "dataType": "double",
            "sourceColumn": "sla_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "rework_pct",
            "dataType": "double",
            "sourceColumn": "rework_pct",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "friction",
