          }
        ],
        "measures": [
          {
            "name": "Avg turnaround (days) (friction)",
            "expression": "AVERAGE ( 'friction'[avg_tat] )",
            "formatString": "#,0.00",
            "description": "Avg turnaround (days) for the 'Friction bands behave the way the score says they should' visual."
          },
          {
            "name": "SLA compliance % (friction)",
            "expression": "AVERAGE ( 'friction'[sla_pct] )",
            "formatString": "#,0.00",
            "description": "SLA compliance % for the 'Friction bands behave the way the score says they should' visual."
          },
          {
            "name": "Rework % (friction)",
            "expression": "AVERAGE ( 'friction'[rework_pct] )",
            "formatString": "#,0.00",
            "description": "Rework % for the 'Friction bands behave the way the score says they should' visual."
          }
        ]
      },
      {
        "name": "by_payer",
        "columns": [
